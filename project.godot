; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

boot_splash/show_image=false
boot_splash/fullsize=true
boot_splash/use_filter=true
boot_splash/bg_color=Color(0.965, 0.945, 0.885, 1)



config/name="Paper Dungeon"
config/description="A turn-based notebook-dungeon adventure where five learning subjects power question-driven battles."
config/version="1.0.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://assets/share/favicon-dungeon-head.png"

[autoload]

TuningBridge="*res://scripts/manus/preview/tuning_adapter.gd"

ManusFontTheme="*res://autoload/manus_font_theme.gd"

SaveStore="*res://autoload/save_store.gd"
I18n="*res://autoload/i18n.gd"
TuningStore="*res://autoload/tuning_store.gd"
AudioDirector="*res://autoload/audio_director.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[gui]


[input]

pause={
"deadzone": 0.3,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":16,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":4194305,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
]
}

[rendering]
environment/defaults/default_clear_color=Color(0.965, 0.945, 0.885, 1)

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"

[editor]
import/use_multiple_threads=false
